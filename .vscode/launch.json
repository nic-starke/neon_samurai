{
  "inputs": [
    {
      "id": "platform",
      "type": "command",
      "command": "cpptools.activeConfigCustomVariable",
      "args": "platform"
    }
  ],
  "configurations": [
    {
      "type": "gdb",
      "request": "attach",
      "name": "Debug (Debug build + Bloom + attach)",
      "executable": "${workspaceFolder}/build/Debug/neosam.elf",
      "target": ":1442",
      "remote": true,
      "cwd": "${workspaceRoot}",
      "valuesFormatting": "parseText",
      "preLaunchTask": "Debug: Build (Debug) & Start Bloom",
      "postDebugTask": "Stop Bloom",
      "autorun": [
        "load",
        "tb main",
        "monitor reset",
      ],
    },
    {
      "type": "gdb",
      "request": "attach",
      "name": "Debug (RelWithDebInfo build + Bloom + attach)",
      "executable": "${workspaceFolder}/build/RelWithDebInfo/neosam.elf",
      "target": ":1442",
      "remote": true,
      "cwd": "${workspaceRoot}",
      "valuesFormatting": "parseText",
      "preLaunchTask": "Debug: Build (RelWithDebInfo) & Start Bloom",
      "postDebugTask": "Stop Bloom",
      "autorun": [
        "load",
        "tb main",
        "monitor reset",
      ],
    },
  ]
}
